# Copy to .env and adjust. Never commit .env.
NODE_ENV=development
PORT=4000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/content_platform

# Auth
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# CORS (comma-separated origins, or * in development)
CORS_ORIGIN=*

# Free daily viewing time (values still to be decided by the team, see spec section 6)
DAILY_FREE_SECONDS=900
QUOTA_WARNING_SECONDS=60
# Cameroon is UTC+1 -> the free time resets at local midnight
QUOTA_RESET_UTC_OFFSET_MINUTES=60
# Largest gap accepted between two usage updates (anti-abuse)
USAGE_HEARTBEAT_MAX_GAP_SECONDS=30

# Email — FR4 password reset
# If SMTP_HOST is left blank in development, the reset link is printed to the console instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@content-platform.local
# Base URL used to build the password-reset link (deep-link or web URL depending on the client).
APP_RESET_URL=http://localhost:8081/reset-password

# Cloudinary (media storage)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Campay (mobile money payments). See the Campay documentation for the exact values.
CAMPAY_BASE_URL=
CAMPAY_APP_USERNAME=
CAMPAY_APP_PASSWORD=
CAMPAY_WEBHOOK_KEY=
